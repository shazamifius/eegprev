<%- include('../partials/header') %>

<div class="container project-view">
    <h1><%= project.title %></h1>
    <p>Par <%= project.author_name %></p>
    <p>Publié le <%= new Date(project.created_at).toLocaleDateString() %></p>

    <div class="project-description">
        <%- project.description %>
    </div>

    <h3>Fichiers du projet</h3>
    <div class="project-files">
        <% if (project.files && project.files.length > 0) { %>
            <ul>
                <% project.files.forEach(file => { %>
                    <li>
                        <% if (project.allow_download) { %>
                            <a href="/uploads/projects/<%= file.file_path %>" download="<%= file.file_name %>"><%= file.file_name %></a>
                        <% } else { %>
                            <span><%= file.file_name %> (téléchargement non autorisé)</span>
                        <% } %>
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <p>Ce projet n'a pas de fichiers.</p>
        <% } %>
    </div>

    <% if (isAuthor) { %>
        <div class="project-actions">
            <a href="/projects/<%= project.id %>/edit" class="btn">Modifier</a>
            <form action="/projects/<%= project.id %>/delete" method="POST" style="display: inline;">
                <button type="submit" class="btn btn-danger">Supprimer</button>
            </form>
        </div>
    <% } %>
</div>

<%- include('../partials/footer') %>
