<%- include('../partials/header', { title: 'Projets', user: user }) %>

<div class="container">
    <div class="page-header-container">
        <div class="page-header-title">
            <h1>Découvrez les projets</h1>
            <div class="page-header-subtitle">Explorez la créativité des étudiants de l'EEGP</div>
        </div>
        <% if (user) { %>
            <a href="/projects/new" class="btn-futuristic-action">
                <span class="btn-icon-circle">
                    <i class="fas fa-plus" style="font-size: 0.8em; color: var(--primary-color);"></i>
                </span>
                <span>Nouveau Projet</span>
            </a>
        <% } %>
    </div>

    <% if (projects && projects.length > 0) { %>
        <div class="modern-project-grid">
            <% projects.forEach(project => { %>
                <div class="modern-project-card">
                    <div class="card-banner-container">
                        <img src="<%= project.banner_image %>" class="card-banner-img" alt="Bannière du projet <%= project.title %>">
                    </div>
                    <div class="card-content">
                        <h3 class="card-title"><%= project.title %></h3>
                        <div class="card-meta">
                            <span><i class="fas fa-user-circle"></i></span>
                            <span class="author-name"><%= project.author_name %></span>
                        </div>
                        <p class="card-summary"><%= project.summary %></p>

                        <div class="card-actions">
                            <a href="/projects/<%= project.id %>" class="btn-card-action">
                                Voir le projet
                            </a>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <div class="text-center" style="padding: 4rem 0;">
            <i class="fas fa-layer-group" style="font-size: 3rem; color: var(--text-secondary); margin-bottom: 1rem;"></i>
            <p style="color: var(--text-secondary); font-size: 1.2rem;">Aucun projet public n'a été trouvé.</p>
            <p>Soyez le premier à en créer un !</p>
        </div>
    <% } %>
</div>

<%- include('../partials/footer') %>
