<%- include('../partials/header') %>

<script src="https://cdn.tiny.cloud/1/YOUR_API_KEY/tinymce/5/tinymce.min.js" referrerpolicy="origin"></script>
<script>
  tinymce.init({
    selector: '#project-description'
  });
</script>

<div class="container">
    <h1>Créer un nouveau projet</h1>
    <form action="/projects/new" method="POST" enctype="multipart/form-data">
        <div class="form-group">
            <label for="title">Titre</label>
            <input type="text" id="title" name="title" class="form-control" required>
        </div>
        <div class="form-group">
            <label for="project-description">Description</label>
            <textarea id="project-description" name="description" class="form-control" rows="10"></textarea>
        </div>
        <div class="form-group">
            <label for="files">Fichiers</label>
            <input type="file" id="files" name="files" class="form-control-file" multiple>
        </div>
        <div class="form-check">
            <input type="checkbox" id="is_public" name="is_public" class="form-check-input">
            <label for="is_public" class="form-check-label">Rendre ce projet public</label>
        </div>
        <div class="form-check">
            <input type="checkbox" id="allow_download" name="allow_download" class="form-check-input" checked>
            <label for="allow_download" class="form-check-label">Autoriser le téléchargement des fichiers</label>
        </div>
        <button type="submit" class="btn">Créer le projet</button>
    </form>
</div>

<%- include('../partials/footer') %>
