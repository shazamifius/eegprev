<%- include('../partials/header', { title: 'Nouveau Projet Local', user: user }) %>

<style>
    .form-container {
        max-width: 900px;
        margin: 40px auto;
    }
    .form-container h1 {
        text-align: center;
        color: var(--accent-color);
    }
    .form-container .form-check {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
    }
    .form-container .form-check-input {
       width: auto;
       margin-bottom: 0;
    }
    .tox-tinymce {
        border-radius: var(--border-radius) !important;
    }
</style>

<div class="form-container">
    <form id="create-project-form" action="/projects/new/internal" method="POST" enctype="multipart/form-data">
        <h1>Nouveau Projet Local</h1>
        <p style="text-align: center; color: var(--text-secondary); margin-bottom: 30px;">Remplissez les informations ci-dessous pour créer votre projet.</p>

        <div class="form-group mb-3">
            <label for="title">Titre du projet</label>
            <input type="text" id="title" name="title" required>
        </div>

        <div class="form-group mb-3">
            <label for="readme_content">Description (README)</label>
            <textarea id="readme_content" name="readme_content" rows="20"></textarea>
            <small style="display: block; margin-top: 5px; color: var(--text-secondary);">Décrivez votre projet en détail. La première image que vous insérez ici servira de bannière.</small>
        </div>

        <div class="form-group mb-3">
            <label>Fichiers du projet</label>
            <%- include('../partials/file-uploader', {
                fieldName: 'project_files',
                labelText: 'Cliquez ou glissez-déposez vos fichiers ici (max 10)',
                isMultiple: true,
                isRequired: false
            }) %>
        </div>

        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="is_public" name="is_public">
            <label class="form-check-label" for="is_public">Rendre ce projet public (visible par tous)</label>
        </div>

        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="allow_download" name="allow_download" checked>
            <label class="form-check-label" for="allow_download">Autoriser le téléchargement des fichiers</label>
        </div>

        <button type="submit" class="button" style="width: 100%; margin-top: 20px;">Créer le projet</button>
    </form>
</div>

<!-- TinyMCE -->
<script src="/js/tinymce/tinymce.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        tinymce.init({
            selector: '#readme_content',
            plugins: 'advlist autolink lists link image charmap print preview hr anchor pagebreak media table paste wordcount',
            toolbar: 'undo redo | styleselect | bold italic underline | fontselect fontsizeselect | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link image media | removeformat | help',
            toolbar_mode: 'floating',
            height: 600,
            skin: 'oxide-dark',
            content_css: 'dark',
            content_style: 'body { font-family:Poppins,sans-serif; font-size:14px; color: #fff; }',
            images_upload_handler: (blobInfo, success, failure) => {
                const formData = new FormData();
                formData.append('file', blobInfo.blob(), blobInfo.filename());

                fetch('/projects/upload-image', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'Accept': 'application/json'
                    }
                })
                .then(response => response.json())
                .then(result => {
                    if (result.location) {
                        success(result.location);
                    } else {
                        failure('Upload failed: ' + result.error);
                    }
                })
                .catch(() => {
                    failure('HTTP Error');
                });
            }
        });

        document.getElementById('create-project-form').addEventListener('submit', function(event) {
            const content = tinymce.get('readme_content').getContent();
            if (!content.includes('<img')) {
                alert('Veuillez insérer au moins une image dans la description (README) pour servir de bannière à votre projet.');
                event.preventDefault();
            }
        });
    });
</script>

<%- include('../partials/footer') %>
