<%- include('../partials/header') %>

<script src="https://cdn.tiny.cloud/1/YOUR_API_KEY/tinymce/5/tinymce.min.js" referrerpolicy="origin"></script>
<script>
  tinymce.init({
    selector: '#project-description'
  });
</script>

<div class="container">
    <h1>Modifier le projet</h1>
    <form action="/projects/<%= project.id %>/edit" method="POST" enctype="multipart/form-data">
        <div class="form-group">
            <label for="title">Titre</label>
            <input type="text" id="title" name="title" class="form-control" value="<%= project.title %>" required>
        </div>
        <div class="form-group">
            <label for="project-description">Description</label>
            <textarea id="project-description" name="description" class="form-control" rows="10"><%= project.description %></textarea>
        </div>
        <div class="form-group">
            <label>Fichiers existants</label>
            <ul>
                <% project.files.forEach(file => { %>
                    <li>
                        <%= file.file_name %>
                        <a href="/projects/<%= project.id %>/files/<%= file.id %>/delete" class="btn btn-danger btn-sm">Supprimer</a>
                    </li>
                <% }); %>
            </ul>
        </div>
        <div class="form-group">
            <label for="files">Ajouter de nouveaux fichiers</label>
            <input type="file" id="files" name="files" class="form-control-file" multiple>
        </div>
        <div class="form-check">
            <input type="checkbox" id="is_public" name="is_public" class="form-check-input" <%= project.is_public ? 'checked' : '' %>>
            <label for="is_public" class="form-check-label">Rendre ce projet public</label>
        </div>
        <div class="form-check">
            <input type="checkbox" id="allow_download" name="allow_download" class="form-check-input" <%= project.allow_download ? 'checked' : '' %>>
            <label for="allow_download" class="form-check-label">Autoriser le téléchargement des fichiers</label>
        </div>
        <button type="submit" class="btn">Mettre à jour le projet</button>
    </form>
</div>

<%- include('../partials/footer') %>
