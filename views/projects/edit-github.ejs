<%- include('../partials/header', { title: 'Modifier le Projet', user: user }) %>

<div class="container">
    <h1>Modifier le Projet GitHub</h1>
    <p class="text-secondary mb-4">
        Ce projet est lié à un dépôt GitHub. Vous pouvez uniquement modifier ses paramètres de visibilité sur notre site.
        <br>
        Pour modifier le contenu (titre, README, fichiers), veuillez le faire directement sur <a href="<%= project.github_url %>" target="_blank">GitHub</a>.
    </p>

    <form action="/projects/<%= project.id %>/edit" method="POST">
        <input type="hidden" name="project_type" value="github">

        <div class="form-group mb-3">
            <label for="title">Titre du projet</label>
            <input type="text" class="form-control" id="title" name="title" value="<%= project.title %>" disabled>
        </div>

        <div class="form-group form-check mb-3">
            <input type="checkbox" class="form-check-input" id="is_public" name="is_public" <%= project.is_public ? 'checked' : '' %>>
            <label class="form-check-label" for="is_public">Rendre ce projet public sur notre site</label>
        </div>

        <div class="form-group form-check mb-3">
            <input type="checkbox" class="form-check-input" id="allow_download" name="allow_download" <%= project.allow_download ? 'checked' : '' %>>
            <label class="form-check-label" for="allow_download">Autoriser le téléchargement des fichiers depuis notre site</label>
        </div>

        <button type="submit" class="btn btn-primary">Enregistrer les modifications</button>
    </form>
</div>

<%- include('../partials/footer') %>
