<%- include('partials/header', { title: "Actualités de l'école", user: user }) %>

<div class="news-container">
    <h1>Actualités de l'école</h1>

    <% if (user && user.is_admin) { %>
        <a href="/news/new" class="button">Créer une nouvelle actualité</a>
    <% } %>

    <div class="news-feed">
        <% news.forEach(article => { %>
            <div class="news-card">
                <h2><%= article.title %></h2>
                <p class="news-date">Publié le <%= new Date(article.created_at).toLocaleDateString() %></p>
                <% if (article.image_path) { %>
                    <img src="<%= article.image_path %>" alt="Image pour <%= article.title %>">
                <% } %>
                <p><%= article.content %></p>
                <% if (article.video_url) { %>
                    <div class="video-container">
                        <iframe src="<%= article.video_url %>" frameborder="0" allowfullscreen></iframe>
                    </div>
                <% } %>
                <% if (user && user.is_admin) { %>
                    <div class="admin-actions">
                        <a href="/news/edit/<%= article.id %>" class="button">Modifier</a>
                        <form action="/news/delete/<%= article.id %>" method="POST" style="display:inline;">
                            <button type="submit" class="button-danger">Supprimer</button>
                        </form>
                    </div>
                <% } %>
            </div>
        <% }); %>
    </div>
</div>

<%- include('partials/footer') %>
