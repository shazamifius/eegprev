<%# views/partials/file-uploader.ejs %>
    <% const fieldName=locals.fieldName || 'file' ; const labelText=locals.labelText
        || 'Cliquez ou glissez-déposez un fichier' ; const isMultiple=locals.isMultiple || false; const
        isRequired=locals.isRequired || false; const accept=locals.accept || 'image/*,video/*' ; const
        allowFolders=locals.allowFolders || false; %>

        <div class="file-uploader-wrapper">
            <div class="file-input-wrapper">
                <div class="file-input-content" style="position: relative; z-index: 2; pointer-events: none;">
                    <span class="file-input-label" style="pointer-events: auto;">
                        <%= labelText %>
                    </span>
                    <% if (allowFolders) { %>
                        <div style="margin-top: 10px; pointer-events: auto;">
                            <span style="font-size: 0.9em; color: var(--text-secondary);">ou</span>
                            <button type="button" class="button-folder-select"
                                style="background: var(--secondary-color); border: none; padding: 5px 10px; border-radius: 4px; color: white; cursor: pointer; font-size: 0.9em; margin-left: 5px;">
                                <i class="fas fa-folder-plus"></i> Sélectionner un dossier
                            </button>
                            <div class="selected-folder-text"
                                style="font-size: 0.8em; color: var(--accent-color); margin-top: 5px;"></div>
                        </div>
                        <% } %>
                </div>

                <!-- Standard File Input (Covers area for drag-drop and click) -->
                <input type="file" class="input-files" name="<%= fieldName %>" <%=isMultiple ? 'multiple' : '' %>
                <%= isRequired ? 'required' : '' %> accept="<%= accept %>">

                        <!-- Folder Input (Hidden, triggered by button) -->
                        <% if (allowFolders) { %>
                            <input type="file" class="input-folder" name="<%= fieldName %>" webkitdirectory directory
                                multiple style="display: none;">
                            <% } %>
            </div>
            <div class="progress-bar-container" style="display: none;">
                <div class="progress-bar"></div>
            </div>
            <div class="upload-status" style="display: none;"></div>
        </div>

        <%# Le CSS et le JS sont directement dans ce partiel pour l'encapsulation %>
            <style>
                .file-input-wrapper {
                    position: relative;
                    overflow: hidden;
                    display: inline-block;
                    width: 100%;
                    box-sizing: border-box;
                    /* Fixes width overflow due to padding */
                    border: 2px dashed var(--secondary-color);
                    border-radius: var(--border-radius);
                    padding: 25px;
                    text-align: center;
                    cursor: pointer;
                    transition: border-style var(--transition-speed), background-color var(--transition-speed);
                }

                .file-input-wrapper:hover,
                .file-input-wrapper.drag-over {
                    border-style: solid;
                    background-color: var(--secondary-color);
                }

                .file-input-wrapper input[type=file] {
                    position: absolute;
                    left: 0;
                    top: 0;
                    opacity: 0;
                    width: 100%;
                    height: 100%;
                    cursor: pointer;
                }

                .file-input-label {
                    color: var(--text-secondary);
                }

                .progress-bar-container {
                    width: 100%;
                    background-color: var(--secondary-color);
                    border-radius: var(--border-radius);
                    margin-top: 10px;
                }

                .progress-bar {
                    width: 0;
                    height: 10px;
                    background-color: var(--primary-color);
                    border-radius: var(--border-radius);
                    transition: width 0.3s ease;
                }

                .upload-status {
                    margin-top: 10px;
                    font-weight: 600;
                }

                .upload-status.success {
                    color: #2ecc71;
                    /* Green */
                }

                .upload-status.error {
                    color: #e74c3c;
                    /* Red */
                }
            </style>
            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    // We need a flag to ensure we only attach one form submit listener
                    if (!window.hasAttachedFormSubmitListener) {
                        const form = document.querySelector('.file-uploader-wrapper')?.closest('form');

                        if (form) {
                            form.addEventListener('submit', function (e) {
                                // Check if there are files selected in any of our uploaders
                                const uploaderInputs = form.querySelectorAll('.file-uploader-wrapper input[type=file]');
                                let hasFilesToUpload = false;
                                uploaderInputs.forEach(input => {
                                    if (input.files.length > 0) {
                                        hasFilesToUpload = true;
                                    }
                                });

                                if (!hasFilesToUpload) {
                                    return; // Allow normal form submission if no files
                                }

                                e.preventDefault();

                                const formData = new FormData(form);
                                const progressBar = form.querySelector('.progress-bar');
                                const progressBarContainer = form.querySelector('.progress-bar-container');
                                const uploadStatus = form.querySelector('.upload-status');

                                // Consolidate files from both inputs?
                                // FormData automatically grabs all inputs with name attribute. 
                                // Since generic File input and Folder input have same name, they will both be appended. Works!

                                const xhr = new XMLHttpRequest();
                                xhr.open(form.method, form.action, true);

                                xhr.upload.addEventListener('progress', function (e) {
                                    if (e.lengthComputable) {
                                        const percentComplete = (e.loaded / e.total) * 100;
                                        progressBar.style.width = percentComplete + '%';
                                        progressBarContainer.style.display = 'block';
                                    }
                                });

                                xhr.addEventListener('load', function () {
                                    if (xhr.status >= 200 && xhr.status < 300) {
                                        window.location.href = xhr.responseURL;
                                    } else {
                                        // Try to parse error message
                                        let errorMsg = 'Erreur lors de l\'upload.';
                                        try {
                                            const response = JSON.parse(xhr.responseText);
                                            if (response.error || response.message) errorMsg = response.error || response.message;
                                        } catch (e) { }

                                        uploadStatus.innerText = errorMsg;
                                        uploadStatus.className = 'upload-status error';
                                        uploadStatus.style.display = 'block';
                                    }
                                });

                                xhr.addEventListener('error', function () {
                                    uploadStatus.innerText = 'Erreur réseau.';
                                    uploadStatus.className = 'upload-status error';
                                    uploadStatus.style.display = 'block';
                                });

                                xhr.send(formData);
                            });
                            window.hasAttachedFormSubmitListener = true;
                        }
                    }

                    document.querySelectorAll('.file-uploader-wrapper').forEach(uploader => {
                        const wrapper = uploader.querySelector('.file-input-wrapper');
                        const inputFile = uploader.querySelector('.input-files');
                        const inputFolder = uploader.querySelector('.input-folder');
                        const label = wrapper.querySelector('.file-input-label');
                        const folderBtn = wrapper.querySelector('.button-folder-select');
                        const folderText = wrapper.querySelector('.selected-folder-text');

                        const defaultLabelText = label.innerText;

                        // Folder Button Logic
                        if (folderBtn && inputFolder) {
                            folderBtn.addEventListener('click', (e) => {
                                e.preventDefault();
                                e.stopPropagation(); // Prevent bubbling to wrapper click
                                inputFolder.click();
                            });

                            inputFolder.addEventListener('change', () => {
                                if (inputFolder.files.length > 0) {
                                    folderText.innerText = `+ ${inputFolder.files.length} fichiers (Dossier)`;
                                    folderText.style.display = 'block';
                                } else {
                                    folderText.style.display = 'none';
                                }
                            });
                        }

                        const handleFiles = (files) => {
                            if (files.length > 0) {
                                let fileNames = Array.from(files).map(f => f.name).join(', ');
                                if (fileNames.length > 40) fileNames = `${files.length} fichier(s) standard sélectionné(s)`;
                                label.innerHTML = fileNames; // Use innerHTML to allow styling if needed, keeping simple
                            } else {
                                label.innerText = defaultLabelText;
                            }
                        };

                        if (inputFile) {
                            inputFile.addEventListener('change', () => handleFiles(inputFile.files));

                            // Drag and drop logic targetting the wrapper but feeding the File input
                            wrapper.addEventListener('dragover', (e) => {
                                e.preventDefault();
                                wrapper.classList.add('drag-over');
                            });
                            wrapper.addEventListener('dragleave', () => wrapper.classList.remove('drag-over'));
                            wrapper.addEventListener('drop', (e) => {
                                e.preventDefault();
                                wrapper.classList.remove('drag-over');
                                inputFile.files = e.dataTransfer.files;
                                handleFiles(inputFile.files);
                            });
                        }
                    });
                });
            </script>