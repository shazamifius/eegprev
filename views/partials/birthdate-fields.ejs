<div class="birthdate-picker">
    <select id="birthdate_day" name="birthdate_day" required>
        <option value="">Jour</option>
    </select>
    <select id="birthdate_month" name="birthdate_month" required>
        <option value="">Mois</option>
    </select>
    <select id="birthdate_year" name="birthdate_year" required>
        <option value="">Année</option>
    </select>
</div>
<input type="hidden" id="birthdate" name="birthdate" value="<%= locals.birthdate || '' %>">

<script>
document.addEventListener('DOMContentLoaded', function() {
    const daySelect = document.getElementById('birthdate_day');
    const monthSelect = document.getElementById('birthdate_month');
    const yearSelect = document.getElementById('birthdate_year');
    const birthdateInput = document.getElementById('birthdate');

    const months = [
        "Janvier", "Février", "Mars", "Avril", "Mai", "Juin",
        "Juillet", "Août", "Septembre", "Octobre", "Novembre", "Décembre"
    ];

    // Populate months
    months.forEach((month, index) => {
        const option = new Option(month, index + 1);
        monthSelect.add(option);
    });

    // Populate years
    const currentYear = new Date().getFullYear();
    for (let i = currentYear; i >= currentYear - 100; i--) {
        const option = new Option(i, i);
        yearSelect.add(option);
    }

    function populateDays() {
        const month = monthSelect.value;
        const year = yearSelect.value;
        const daysInMonth = (month && year) ? new Date(year, month, 0).getDate() : 31;

        const selectedDay = daySelect.value;
        daySelect.innerHTML = '<option value="">Jour</option>';

        for (let i = 1; i <= daysInMonth; i++) {
            const option = new Option(i, i);
            daySelect.add(option);
        }

        if (selectedDay) {
            daySelect.value = selectedDay;
        }
    }

    function updateHiddenBirthdate() {
        const day = String(daySelect.value).padStart(2, '0');
        const month = String(monthSelect.value).padStart(2, '0');
        const year = yearSelect.value;

        if (day && month && year && day !== '00' && month !== '00') {
            birthdateInput.value = `${year}-${month}-${day}`;
        } else {
            birthdateInput.value = '';
        }
    }

    // Set initial values if birthdate is available (for edit page)
    const existingBirthdate = birthdateInput.value;
    if (existingBirthdate) {
        const parts = existingBirthdate.split('-');
        if (parts.length === 3) {
            yearSelect.value = parts[0];
            monthSelect.value = parseInt(parts[1], 10);
            populateDays();
            daySelect.value = parseInt(parts[2], 10);
        }
    }

    monthSelect.addEventListener('change', populateDays);
    yearSelect.addEventListener('change', populateDays);

    daySelect.addEventListener('change', updateHiddenBirthdate);
    monthSelect.addEventListener('change', updateHiddenBirthdate);
    yearSelect.addEventListener('change', updateHiddenBirthdate);

    // Initial population
    populateDays();
});
</script>
