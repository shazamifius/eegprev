<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> - EEGP
    </title>
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/modern-theme.css">
    <link rel="stylesheet" href="/css/checkbox.css">
    <link rel="stylesheet" href="/css/beacon.css">
    <link rel="stylesheet" href="/css/help.css">
    <link rel="stylesheet" href="/css/projects.css">
    <link rel="stylesheet" href="/css/clock.css"> <!-- Clock Styles -->

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/socket-client.js"></script>
    <script src="/js/clock.js" defer></script>

    <% if (typeof user !=='undefined' && user) { %>
        <style>
            :root {
                --background-dark: <%=user.color_bg || '#23272A' %>;
                --text-primary: <%=user.color_text || '#ffffff' %>;
                --primary-color: <%=user.color_primary || '#d95e4f' %>;
                --secondary-color: <%=user.color_secondary || '#41435e' %>;
            }
        </style>
        <% } %>
</head>

<body <%=(typeof user !=='undefined' && user) ? `data-user-id=${user.id}` : '' %>>
    <header>
        <div class="container" style="position: relative; height: 80px; display: flex; align-items: center;">
            <!-- Logo area REMOVED -->

            <!-- Absolute Center Group -->

            <!-- Mobile Menu Toggle -->
            <button class="mobile-menu-toggle">
                <i class="fas fa-bars"></i>
            </button>

            <!-- Absolute Center Group (Desktop) -->
            <div class="header-center-group">
                <!-- Left Navigation -->
                <nav class="nav-left">
                    <ul>
                        <% if (typeof user !=='undefined' && user) { %>
                            <li><a href="/">Accueil</a></li>
                            <li><a href="/students">Élèves</a></li>
                            <li><a href="/projects">Projets</a></li>
                            <li><a href="/projects/my-projects">Mes Projets</a></li>
                            <% } else { %>
                                <li><a href="/login">Connexion</a></li>
                                <% } %>
                    </ul>
                </nav>

                <!-- Centered Clock -->
                <div class="clock__container">
                    <div class="clock__content grid">
                        <div class="clock__circle">
                            <span class="clock__twelve"></span>
                            <span class="clock__three"></span>
                            <span class="clock__six"></span>
                            <span class="clock__nine"></span>

                            <div class="clock__rounder"></div>
                            <div class="clock__hour" id="clock-hour"></div>
                            <div class="clock__minutes" id="clock-minutes"></div>
                            <div class="clock__seconds" id="clock-seconds"></div>
                        </div>
                    </div>
                </div>

                <!-- Right Navigation -->
                <nav class="nav-right">
                    <ul>
                        <% if (typeof user !=='undefined' && user) { %>
                            <li><a href="/publications">Publications</a></li>
                            <li><a href="/news">Actualités</a></li>
                            <li><a href="/help">Entraide</a></li>
                            <li><a href="/chat">Chat</a></li>
                            <li><a href="/profile">Profil</a></li>
                            <li><a href="/logout" style="color: var(--primary-color);"> <i
                                        class="fas fa-power-off"></i></a>
                            </li>
                            <% } else { %>
                                <li><a href="/register">Inscription</a></li>
                                <% } %>
                    </ul>
                </nav>
            </div>

            <!-- Mobile Menu Overlay -->
            <div class="mobile-menu-overlay">
                <div class="mobile-menu-header">
                    <h3>Menu</h3>
                    <button class="mobile-menu-close"><i class="fas fa-times"></i></button>
                </div>
                <nav class="mobile-nav">
                    <ul>
                        <% if (typeof user !=='undefined' && user) { %>
                            <li><a href="/" class="mobile-link"><i class="fas fa-home"></i> Accueil</a></li>
                            <li><a href="/students" class="mobile-link"><i class="fas fa-users"></i> Élèves</a></li>
                            <li><a href="/projects" class="mobile-link"><i class="fas fa-project-diagram"></i>
                                    Projets</a></li>
                            <li><a href="/projects/my-projects" class="mobile-link"><i class="fas fa-layer-group"></i>
                                    Mes Projets</a></li>
                            <hr class="mobile-divider">
                            <li><a href="/publications" class="mobile-link"><i class="fas fa-newspaper"></i>
                                    Publications</a></li>
                            <li><a href="/news" class="mobile-link"><i class="fas fa-bullhorn"></i> Actualités</a></li>
                            <li><a href="/help" class="mobile-link"><i class="fas fa-hands-helping"></i> Entraide</a>
                            </li>
                            <li><a href="/chat" class="mobile-link"><i class="fas fa-comments"></i> Chat</a></li>
                            <hr class="mobile-divider">
                            <li><a href="/profile" class="mobile-link"><i class="fas fa-user-circle"></i> Profil</a>
                            </li>
                            <li><a href="/logout" class="mobile-link logout"><i class="fas fa-power-off"></i>
                                    Déconnexion</a></li>
                            <% } else { %>
                                <li><a href="/login" class="mobile-link"><i class="fas fa-sign-in-alt"></i>
                                        Connexion</a></li>
                                <li><a href="/register" class="mobile-link"><i class="fas fa-user-plus"></i>
                                        Inscription</a></li>
                                <% } %>
                    </ul>
                </nav>
            </div>
        </div>
    </header>
    <script src="/js/header.js"></script>

    <% if (typeof user !=='undefined' && user) { %>
        <!-- Legacy Beacon Widget Removed - Replaced by Workspace Widget on Dashboard -->
        <% } %>

            <% if (typeof fullscreen==='undefined' || !fullscreen) { %>
                <div class="container">
                    <% } %>