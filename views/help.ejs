<%- include('partials/header', { title: title }) %>

<style>
    /* Help Hub Specific Styles */
    .help-header {
        background: linear-gradient(135deg, #1e293b, #0f172a);
        padding: 3rem 2rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        text-align: center;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    }

    .help-header h1 {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
        background: linear-gradient(to right, #60a5fa, #a78bfa);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .help-tabs {
        display: flex;
        justify-content: center;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .help-tab {
        padding: 0.75rem 1.5rem;
        border-radius: 9999px;
        background: #1e293b;
        color: #94a3b8;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.2s;
        border: 1px solid #334155;
    }

    .help-tab.active, .help-tab:hover {
        background: #2563eb;
        color: white;
        border-color: #2563eb;
    }

    .help-tab.swap-tab.active {
        background: #d946ef; /* Fuchsia for swap */
        border-color: #d946ef;
    }

    .filters-bar {
        display: flex;
        gap: 1rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        align-items: center;
    }

    .filter-btn {
        background: transparent;
        border: 1px solid #475569;
        color: #cbd5e1;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        cursor: pointer;
    }

    .request-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.5rem;
    }

    .request-card {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 12px;
        padding: 1.5rem;
        transition: transform 0.2s;
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
    }

    .request-card:hover {
        transform: translateY(-4px);
        border-color: #475569;
    }

    .request-card.swap-card {
        border-left: 4px solid #d946ef;
    }

    .request-card.help-card {
        border-left: 4px solid #3b82f6;
    }

    .request-card.resolved {
        opacity: 0.7;
    }

    .status-badge {
        position: absolute;
        top: 1rem;
        right: 1rem;
        font-size: 0.75rem;
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        font-weight: bold;
    }

    .status-badge.open { background: rgba(59, 130, 246, 0.2); color: #60a5fa; }
    .status-badge.resolved { background: rgba(34, 197, 94, 0.2); color: #4ade80; }

    .card-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    .card-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
    }

    .card-meta h3 {
        font-size: 0.95rem;
        margin: 0;
        color: #e2e8f0;
    }

    .card-meta span {
        font-size: 0.8rem;
        color: #94a3b8;
    }

    .card-title {
        font-size: 1.25rem;
        margin-bottom: 0.75rem;
        color: white;
        font-weight: 700;
        line-height: 1.4;
    }

    .card-tags {
        display: flex;
        gap: 0.5rem;
        margin-top: auto;
        padding-top: 1rem;
        flex-wrap: wrap;
    }

    .tag {
        font-size: 0.75rem;
        padding: 0.25rem 0.5rem;
        background: #334155;
        border-radius: 4px;
        color: #cbd5e1;
    }

    .incognito-toggle {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
        user-select: none;
        margin-top: 1rem;
        color: #cbd5e1;
    }

    /* Modal Styling for New Request */
    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.7);
        backdrop-filter: blur(5px);
    }

    .modal-content {
        background-color: #1e293b;
        margin: 5% auto;
        padding: 2rem;
        border: 1px solid #475569;
        border-radius: 12px;
        width: 90%;
        max-width: 600px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        color: #e2e8f0;
        font-weight: 500;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem;
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 6px;
        color: white;
        font-size: 1rem;
        box-sizing: border-box;
    }

    .form-control:focus {
        border-color: #3b82f6;
        outline: none;
    }

</style>

<div class="main-container">

    <div class="help-header">
        <h1>Hub Entraide & Collaboration</h1>
        <p style="color: #94a3b8; max-width: 600px; margin: 0 auto;">Pose tes questions, partage tes compétences, et trouve des partenaires pour tes projets. Ensemble, on va plus loin.</p>

        <div style="margin-top: 2rem;">
            <button onclick="openModal('help')" class="btn btn-primary"><i class="fas fa-question-circle"></i> Demander de l'Aide</button>
            <button onclick="openModal('swap')" class="btn" style="background: #d946ef; color: white; margin-left: 1rem;"><i class="fas fa-sync-alt"></i> Proposer un Échange</button>
        </div>
    </div>

    <div class="help-tabs">
        <a href="/help" class="help-tab <%= !filters.type || filters.type === 'help' ? 'active' : '' %>">
            <i class="fas fa-hands-helping"></i> Demandes d'Aide
        </a>
        <a href="/help?type=swap" class="help-tab swap-tab <%= filters.type === 'swap' ? 'active' : '' %>">
            <i class="fas fa-exchange-alt"></i> Échange de Compétences
        </a>
    </div>

    <div class="filters-bar">
        <span style="color: #94a3b8; font-weight: 600; margin-right: 0.5rem;">Filtrer par :</span>
        <a href="/help<%= filters.type ? '?type='+filters.type : '' %>" class="filter-btn">Tout</a>
        <a href="/help?category=Développement<%= filters.type ? '&type='+filters.type : '' %>" class="filter-btn">Dev</a>
        <a href="/help?category=Design<%= filters.type ? '&type='+filters.type : '' %>" class="filter-btn">Design</a>
        <a href="/help?category=3D<%= filters.type ? '&type='+filters.type : '' %>" class="filter-btn">3D</a>
        <a href="/help?status=ouverte<%= filters.type ? '&type='+filters.type : '' %>" class="filter-btn">Ouvertes uniquement</a>
    </div>

    <div class="request-grid">
        <% if (requests.length === 0) { %>
            <div style="grid-column: 1 / -1; text-align: center; padding: 4rem; color: #94a3b8;">
                <i class="fas fa-wind" style="font-size: 3rem; margin-bottom: 1rem; display: block;"></i>
                <p>C'est calme par ici... Lance le mouvement !</p>
            </div>
        <% } %>

        <% requests.forEach(request => { %>
            <div class="request-card <%= request.request_type === 'swap' ? 'swap-card' : 'help-card' %> <%= request.status === 'résolue' ? 'resolved' : '' %>" onclick="window.location.href='/help/<%= request.id %>'" style="cursor: pointer;">
                <div class="status-badge <%= request.status === 'résolue' ? 'resolved' : 'open' %>">
                    <%= request.status === 'résolue' ? 'Résolu' : 'Ouvert' %>
                </div>

                <div class="card-header">
                    <img src="<%= request.authorAvatar %>" alt="Avatar" class="card-avatar">
                    <div class="card-meta">
                        <h3><%= request.authorName %></h3>
                        <span><%= new Date(request.created_at).toLocaleDateString() %> • <%= request.category %></span>
                    </div>
                </div>

                <div class="card-title">
                    <%= request.title %>
                </div>

                <p style="color: #cbd5e1; font-size: 0.9rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                    <%= request.description %>
                </p>

                <div class="card-tags">
                    <% if (request.tags) { %>
                        <% request.tags.split(',').forEach(tag => { %>
                            <span class="tag"><%= tag.trim() %></span>
                        <% }) %>
                    <% } %>
                    <% if (request.request_type === 'swap') { %>
                        <span class="tag" style="background: #701a75; color: #f5d0fe;">Skill Swap</span>
                    <% } %>
                </div>
            </div>
        <% }) %>
    </div>
</div>

<!-- Modal Creation -->
<div id="newRequestModal" class="modal">
    <div class="modal-content">
        <span onclick="closeModal()" style="float: right; cursor: pointer; color: #94a3b8; font-size: 1.5rem;">&times;</span>
        <h2 id="modalTitle" style="color: white; margin-bottom: 1.5rem;">Nouvelle Demande</h2>

        <form action="/help/new" method="POST">
            <input type="hidden" name="request_type" id="requestTypeInput" value="help">

            <div class="form-group">
                <label>Titre</label>
                <input type="text" name="title" class="form-control" placeholder="Ex: Problème de rendu Blender..." required>
            </div>

            <div class="form-group">
                <label>Catégorie</label>
                <select name="category" class="form-control">
                    <option value="Général">Général</option>
                    <option value="Développement">Développement</option>
                    <option value="Design">Design</option>
                    <option value="3D">3D</option>
                    <option value="Vidéo">Vidéo</option>
                    <option value="Autre">Autre</option>
                </select>
            </div>

            <div class="form-group">
                <label>Tags (séparés par des virgules)</label>
                <input type="text" name="tags" class="form-control" placeholder="Ex: C++, Texture, Urgent">
            </div>

            <div class="form-group">
                <label>Description</label>
                <textarea name="description" class="form-control" rows="5" required></textarea>
            </div>

            <div class="form-group">
                <label class="incognito-toggle">
                    <input type="checkbox" name="is_anonymous">
                    <i class="fas fa-user-secret"></i> Poster en mode Incognito (Anonyme)
                </label>
                <p style="font-size: 0.8rem; color: #64748b; margin-top: 0.25rem;">Seuls les admins verront ton nom. Idéal si tu es timide.</p>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%;">Publier</button>
        </form>
    </div>
</div>

<script>
    function openModal(type) {
        const modal = document.getElementById('newRequestModal');
        const title = document.getElementById('modalTitle');
        const typeInput = document.getElementById('requestTypeInput');

        modal.style.display = 'block';
        if (type === 'swap') {
            title.textContent = "Proposer un Échange de Compétences";
            title.style.color = '#d946ef';
            typeInput.value = 'swap';
        } else {
            title.textContent = "Demander de l'Aide";
            title.style.color = 'white';
            typeInput.value = 'help';
        }
    }

    function closeModal() {
        document.getElementById('newRequestModal').style.display = 'none';
    }

    window.onclick = function(event) {
        const modal = document.getElementById('newRequestModal');
        if (event.target == modal) {
            modal.style.display = "none";
        }
    }
</script>

<%- include('partials/footer') %>
