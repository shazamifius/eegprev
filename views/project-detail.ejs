<%- include('partials/header', { title: project.title, user: user }) %>

<div class="project-detail-container">
    <h1><%= project.title %></h1>
    <p class="project-author">par <a href="/students/<%= project.author_id %>"><%= project.authorName %></a></p>

    <div class="project-detail-images">
        <div class="project-detail-main-image">
            <img src="<%= project.main_image || '/images/default-project.png' %>" alt="Image principale de <%= project.title %>">
        </div>
        <div class="project-detail-thumbnails">
            <% if (project.secondary_images && project.secondary_images.length > 0) { %>
                <% project.secondary_images.forEach(image => { %>
                    <div class="project-detail-thumbnail">
                        <img src="<%= image %>" alt="Image secondaire de <%= project.title %>">
                    </div>
                <% }); %>
            <% } %>
        </div>
    </div>

    <div class="project-detail-info">
        <h2>Participants</h2>
        <p><strong>Auteur :</strong> <a href="/students/<%= project.author_id %>"><%= project.authorName %></a></p>
        <% if (collaborators && collaborators.length > 0) { %>
            <p><strong>Collaborateurs :</strong>
                <% collaborators.forEach((collaborator, index) => { %>
                    <a href="/students/<%= collaborator.id %>"><%= collaborator.name %></a><%= index < collaborators.length - 1 ? ', ' : '' %>
                <% }); %>
            </p>
        <% } %>

        <h2>Description</h2>
        <p><%= project.description %></p>

        <div class="project-detail-footer">
            <form action="/projects/<%= project.id %>/upvote" method="POST">
                <button type="submit" class="upvote-button">▲ Upvote (<%= project.upvotes %>)</button>
            </form>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
