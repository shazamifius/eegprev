<%- include('partials/header', { title: "Projets", user: user }) %>

<div class="projects-container">
    <div class="projects-header">
        <h1>Explorer les Projets</h1>
        <% if (user) { %>
            <a href="/projects/new" class="button">Créer un nouveau projet</a>
        <% } %>
    </div>

    <div class="projects-grid">
        <% projects.forEach(project => { %>
            <a href="/projects/<%= project.id %>" class="project-card-link">
                <div class="project-card">
                    <div class="project-card-images">
                        <div class="project-card-main-image">
                            <img src="<%= project.main_image || '/images/default-project.png' %>" alt="Image principale de <%= project.title %>">
                        </div>
                        <div class="project-card-thumbnails">
                            <% if (project.secondary_images && project.secondary_images.length > 0) { %>
                                <% project.secondary_images.slice(0, 3).forEach(image => { %>
                                    <div class="project-card-thumbnail">
                                        <img src="<%= image %>" alt="Image secondaire de <%= project.title %>">
                                    </div>
                                <% }); %>
                            <% } %>
                        </div>
                    </div>
                    <div class="project-card-info">
                        <h3><%= project.title %></h3>
                        <p class="project-card-description"><%= project.description.substring(0, 100) %>...</p>
                        <div class="project-card-footer">
                            <span class="project-author">par <%= project.authorName %></span>
                            <span class="project-upvotes">▲ <%= project.upvotes %></span>
                        </div>
                    </div>
                </div>
            </a>
        <% }); %>
    </div>
</div>

<%- include('partials/footer') %>
