<%- include('partials/header', { title: "Projets" , user: user }) %>

    <div class="projects-container">
        <div class="projects-header">
            <h1>Explorer les Projets</h1>
            <% if (user) { %>
                <a href="/projects/new" class="button">Créer un nouveau projet</a>
                <% } %>
        </div>

        <div class="projects-grid">
            <% projects.forEach(project=> { %>
                <!-- Clickable Article instead of Anchor wrapper to allow nested buttons -->
                <article class="modern-project-card" onclick="window.location.href='/projects/<%= project.id %>'"
                    style="cursor: pointer;">
                    <button class="btn-warn"
                        onclick="openReportModal('project', '<%= project.id %>'); event.stopPropagation();"
                        title="Signaler">
                        <i class="fas fa-exclamation"></i>
                    </button>

                    <div class="card-banner-container">
                        <img src="<%= project.main_image || '/images/default-project.png' %>" alt="<%= project.title %>"
                            class="card-banner-img">
                    </div>

                    <div class="card-content">
                        <h3 class="card-title">
                            <%= project.title %>
                        </h3>

                        <div class="card-meta">
                            <span class="author-name">par <%= project.authorName %></span>
                            <span class="project-upvotes" style="margin-left: auto;">
                                <i class="fas fa-arrow-up"></i>
                                <%= project.upvotes %>
                            </span>
                        </div>

                        <p class="card-summary">
                            <%= project.description.length> 100 ? project.description.substring(0, 100) + '...' :
                                project.description %>
                        </p>

                        <div class="card-actions">
                            <span class="btn-card-action">Voir le projet</span>
                        </div>
                    </div>
                </article>
                <% }); %>
        </div>
    </div>

    <%- include('partials/report-modal') %>
        <%- include('partials/footer') %>