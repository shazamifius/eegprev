<%- include('partials/header', { title: "Connexion" , user: undefined }) %>

    <link rel="stylesheet" href="/css/login-custom.css">
    <!-- Inline styles from login-form moved to separate file or inline here for simplicity since it's page-specific -->
    <style>
        /* Adapter for login-form styles within the EJS layout */
        :root {
            --login-bg: #2b2e38;
            --login-text: #ffeba7;
            --input-bg: #1f2029;
            --input-icon: #c4c3ca;
            --input-text: #c4c3ca;
        }

        /* Override body alignment from original demo to fit in template */
        .login-section {
            position: relative;
            width: 100%;
            display: block;
            padding-top: 60px;
            padding-bottom: 60px;
        }

        .checkbox:checked+label,
        .checkbox:not(:checked)+label {
            color: var(--text-primary);
        }

        /* Flip Card Styles */
        .card-3d-wrap {
            position: relative;
            width: 440px;
            max-width: 100%;
            /* Increased min-height to prevent content overlapping */
            min-height: 550px; 
            -webkit-transform-style: preserve-3d;
            transform-style: preserve-3d;
            perspective: 800px;
            margin-left: auto;
            margin-right: auto;
        }

        .card-3d-wrapper {
            width: 100%;
            height: 100%;
            position: absolute;
            -webkit-transform-style: preserve-3d;
            transform-style: preserve-3d;
            transition: all 600ms ease-out;
        }

        .card-front,
        .card-back {
            width: 100%;
            height: 100%;
            background-color: var(--background-light);
            background-image: url('https://s3-us-west-2.amazonaws.com/s.cdpn.io/1462889/pat.svg');
            background-position: bottom center;
            background-repeat: no-repeat;
            background-size: 300%;
            position: absolute;
            border-radius: 6px;
            -webkit-transform-style: preserve-3d;
            backface-visibility: hidden;
            overflow: hidden; 
            box-shadow: 0 4px 8px 0 rgba(0,0,0,0.2);
        }

        .card-back {
            transform: rotateY(180deg);
        }

        .checkbox:checked~.card-3d-wrap .card-3d-wrapper {
            transform: rotateY(180deg);
        }

        .center-wrap {
            position: absolute;
            width: 100%;
            padding: 0 35px;
            top: 50%;
            left: 0;
            transform: translate3d(0, -50%, 35px) perspective(100px);
            z-index: 20;
            display: block;
        }

        .form-group {
            position: relative;
            display: block;
            margin: 0 0 15px 0;
            padding: 0;
        }

        .form-style {
            padding: 13px 20px;
            padding-left: 55px;
            height: 48px;
            width: 100%;
            font-weight: 500;
            border-radius: 4px;
            font-size: 14px;
            line-height: 22px;
            letter-spacing: 0.5px;
            outline: none;
            color: var(--text-primary);
            background-color: var(--input-bg);
            border: none;
            transition: all 200ms linear;
            box-shadow: 0 4px 8px 0 rgba(21, 21, 21, .2);
            box-sizing: border-box;
        }

        .form-style:focus {
            box-shadow: 0 4px 8px 0 rgba(21, 21, 21, .2);
            border: 1px solid var(--primary-color);
        }

        .input-icon {
            position: absolute;
            top: 0;
            left: 18px;
            height: 48px;
            font-size: 24px;
            line-height: 48px;
            text-align: left;
            color: var(--primary-color);
            pointer-events: none;
        }

        .btn-login {
            border-radius: 4px;
            height: 44px;
            font-size: 13px;
            font-weight: 600;
            text-transform: uppercase;
            transition: all 200ms linear;
            padding: 0 30px;
            letter-spacing: 1px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background-color: var(--primary-color);
            color: var(--text-primary);
            border: none;
            cursor: pointer;
            box-shadow: 0 8px 24px 0 rgba(16, 39, 112, .2);
            width: 100%;
        }

        .btn-login:hover {
            background-color: var(--secondary-color);
            color: var(--text-primary);
        }

        /* Switcher at top */
        .section h6 {
            text-align: center;
            margin-bottom: 20px;
        }

        .section h6 span {
            padding: 0 20px;
            text-transform: uppercase;
            font-weight: 700;
            font-size: 14px;
            color: var(--text-secondary);
            cursor: pointer;
        }

        .section h6 span.active {
            color: var(--primary-color);
        }

        /* Checkbox visual - reusing checkbox.css logic or hiding it */
        #reg-log {
            display: none;
        }

        .checkbox:checked+label,
        .checkbox:not(:checked)+label {
            position: relative;
            display: block;
            text-align: center;
            width: 60px;
            height: 16px;
            border-radius: 8px;
            padding: 0;
            margin: 10px auto;
            cursor: pointer;
            background-color: var(--text-secondary);
        }

        .checkbox:checked+label:before,
        .checkbox:not(:checked)+label:before {
            position: absolute;
            display: block;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            color: var(--text-primary);
            background-color: var(--primary-color);
            font-family: 'Font Awesome 5 Free';
            content: '\f061';
            /* Arrow */
            font-weight: 900;
            z-index: 20;
            top: -10px;
            left: -10px;
            line-height: 36px;
            text-align: center;
            font-size: 18px;
            /* Smaller icon size */
            transition: all 0.5s ease;
        }

        .checkbox:checked+label:before {
            transform: translateX(44px) rotate(-180deg);
        }
        
        @media (max-width: 500px) {
            .card-3d-wrap {
                width: 100%;
                padding: 0 10px;
            }
            .center-wrap {
                padding: 0 20px;
            }
        }
    </style>

    <div class="login-section">
        <div class="container">
            <div class="row full-height justify-content-center">
                <div class="col-12 text-center align-self-center py-5">
                    <div class="section pb-5 pt-5 pt-sm-2 text-center">

                        <h6 class="mb-0 pb-3"><span>Connexion</span><span>Inscription</span></h6>
                        <input class="checkbox" type="checkbox" id="reg-log" name="reg-log" />
                        <label for="reg-log"></label>

                        <div class="card-3d-wrap mx-auto">
                            <div class="card-3d-wrapper">

                                <!-- Front: LOGIN -->
                                <div class="card-front">
                                    <div class="center-wrap">
                                        <div class="section text-center">
                                            <h4 class="mb-4 pb-3" style="color: var(--text-primary);">Connexion</h4>
                                            <form action="/login" method="POST">
                                                <% if (error && error.length> 0) { %>
                                                    <div style="color: #ff6b6b; margin-bottom: 10px; font-size: 0.9em;">
                                                        <%= error %>
                                                    </div>
                                                    <% } %>
                                                        <div class="form-group">
                                                            <input type="email" name="email" class="form-style"
                                                                placeholder="Email" id="logemail" autocomplete="off"
                                                                required>
                                                            <i class="input-icon fas fa-at"></i>
                                                        </div>
                                                        <div class="form-group mt-2">
                                                            <input type="password" name="password" class="form-style"
                                                                placeholder="Mot de passe" id="logpass"
                                                                autocomplete="off" required>
                                                            <i class="input-icon fas fa-lock"></i>
                                                        </div>
                                                        <button type="submit" class="btn-login mt-4">Se
                                                            connecter</button>
                                            </form>
                                            <p class="mb-0 mt-4 text-center"><a href="#" class="link"
                                                    style="color: var(--text-secondary);">Mot de passe oublié ?</a></p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Back: REGISTER LINK/PREVIEW -->
                                <div class="card-back">
                                    <div class="center-wrap">
                                        <div class="section text-center">
                                            <h4 class="mb-4 pb-3" style="color: var(--text-primary);">Nouveau Compte ?
                                            </h4>
                                            <p style="color: var(--text-secondary); margin-bottom: 2rem;">
                                                Rejoignez l'EEGP Community pour partager vos projets et échanger avec
                                                les autres élèves.
                                            </p>
                                            <p style="color: var(--text-secondary); margin-bottom: 2rem;">
                                                L'inscription complète nécessite votre biographie, avatar et liens
                                                sociaux.
                                            </p>
                                            <a href="/register" class="btn-login mt-4">Créer un compte</a>
                                            <p class="mb-0 mt-4 text-center"
                                                style="font-size: 0.8rem; color: var(--text-secondary);">
                                                Réservé aux étudiants EEGP
                                            </p>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts for the flip functionality (handled by CSS checkbox mostly) -->
    <script>
