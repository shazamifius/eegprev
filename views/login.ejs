        const spans = document.querySelectorAll('.section h6 span');
        const checkbox = document.getElementById('reg-log');
        spans[0].addEventListener('click', () => { checkbox.checked = false; });
        spans[1].addEventListener('click', () => { checkbox.checked = true; });
        */
    </script>

    <%- include('partials/footer') %>