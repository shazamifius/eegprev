<%- include('partials/header', { title: "Profil de " + user.name, user: sessionUser }) %>

<div class="profile-container">
    <!-- Bannière Showcase -->
    <div class="profile-banner">
        <% if (showcaseImages && showcaseImages.length > 0) { %>
            <% for (let i = 0; i < 4; i++) { %>
                <div class="showcase-image-container">
                    <% if (showcaseImages[i]) { %>
                        <img src="<%= showcaseImages[i].image_path %>" alt="Image Showcase <%= i + 1 %>">
                    <% } else { %>
                        <div class="showcase-placeholder"></div>
                    <% } %>
                </div>
            <% } %>
        <% } else { %>
            <div class="showcase-placeholder-full">Bannière vide</div>
        <% } %>
    </div>

    <!-- Informations principales -->
    <div class="profile-header">
        <img class="profile-avatar" src="<%= user.avatar || '/images/default-avatar.png' %>" alt="Avatar de <%= user.name %>">
        <div class="profile-header-info">
            <h1><%= user.name %></h1>
            <p class="user-class"><%= user.classe || 'Classe non spécifiée' %></p>
        </div>
        <% if (sessionUser && sessionUser.id === user.id) { %>
            <a href="/profile/edit" class="edit-profile-button">Modifier mon profil</a>
        <% } %>
    </div>

    <!-- Contenu du profil -->
    <div class="profile-content">
        <div class="profile-sidebar">
            <h2>À propos</h2>
            <p class="user-bio"><%= user.bio || 'Aucune biographie.' %></p>

            <div class="social-links">
                <% if (user.discord) { %><a href="https://discordapp.com/users/<%= user.discord %>" target="_blank">[D] Discord</a><% } %>
                <% if (user.instagram) { %><a href="https://instagram.com/<%= user.instagram %>" target="_blank">[I] Instagram</a><% } %>
                <% if (user.snapchat) { %><a href="https://snapchat.com/add/<%= user.snapchat %>" target="_blank">[S] Snapchat</a><% } %>
            </div>
             <div class="portfolio-link">
                <% if (user.portfolio) { %><a href="<%= user.portfolio %>" target="_blank">Portfolio Externe</a><% } %>
            </div>
        </div>

        <div class="profile-main">
            <!-- Section des Projets -->
            <h2>Projets de <%= user.name %></h2>
            <div class="projects-grid">
                <% if (projects && projects.length > 0) { %>
                    <% projects.forEach(project => { %>
                        <div class="project-card">
                             <!-- Ici, nous devrions avoir l'image principale du projet -->
                            <h3><%= project.title %></h3>
                            <p><%= project.description.substring(0, 100) %>...</p>
                            <!-- Bouton Upvote et autres détails du projet à ajouter -->
                        </div>
                    <% }); %>
                <% } else { %>
                    <p><%= user.name %> n'a pas encore publié de projet.</p>
                <% } %>
            </div>

            <!-- Section des Publications (Posts) -->
            <hr>
            <h2>Publications de <%= user.name %></h2>
            <div class="posts-feed">
                <% if (posts && posts.length > 0) { %>
                    <% posts.forEach(post => { %>
                        <div class="post-card-minimal">
                            <p><%= post.content %></p>
                            <% if (post.media_path) { %>
                                <img src="<%= post.media_path %>" alt="Média de la publication" style="max-width: 100%; border-radius: 8px;">
                            <% } %>
                            <span class="post-date"><%= new Date(post.created_at).toLocaleString() %></span>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p>Aucune publication pour le moment.</p>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
