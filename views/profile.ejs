<%- include('partials/header', { title: "Profil de " + user.name, user: sessionUser }) %>

<div class="profile-container">
    <!-- Bannière Showcase -->
    <div class="profile-banner">
        <% for (let i = 0; i < 4; i++) { %>
            <div class="showcase-image-container">
                <% if (showcaseImages && showcaseImages[i]) { %>
                    <img src="<%= showcaseImages[i].image_path %>" alt="Image Showcase <%= i + 1 %>">
                <% } else { %>
                    <div class="showcase-placeholder"></div>
                <% } %>
            </div>
        <% } %>
    </div>

    <!-- Informations principales -->
    <div class="profile-header">
        <img class="profile-avatar" src="<%= user.avatar || '/images/default-avatar.png' %>" alt="Avatar de <%= user.name %>">
        <div class="profile-header-info">
            <h1><%= user.name %></h1>
            <p class="user-class"><%= user.classe || 'Classe non spécifiée' %></p>
        </div>
        <% if (sessionUser && sessionUser.id === user.id) { %>
            <a href="/profile/edit" class="edit-profile-button">Modifier mon profil</a>
        <% } %>
    </div>

    <!-- Contenu du profil -->
    <div class="profile-content">
        <div class="profile-sidebar">
            <h2>À propos</h2>
            <p class="user-bio"><%= user.bio || 'Aucune biographie.' %></p>

            <div class="social-links">
                <% if (user.discord) { %><a href="https://discordapp.com/users/<%= user.discord %>" target="_blank"><i class="fab fa-discord"></i></a><% } %>
                <% if (user.instagram) { %><a href="https://instagram.com/<%= user.instagram %>" target="_blank"><i class="fab fa-instagram"></i></a><% } %>
                <% if (user.snapchat) { %><a href="https://snapchat.com/add/<%= user.snapchat %>" target="_blank"><i class="fab fa-snapchat"></i></a><% } %>
            </div>
            <div class="portfolio-links">
                <% if (portfolioLinks && portfolioLinks.length > 0) { %>
                    <% portfolioLinks.forEach(link => { %>
                        <a href="<%= link.url %>" class="portfolio-button" target="_blank" rel="noopener noreferrer">
                            <img src="<%= link.icon %>" alt="" class="portfolio-icon">
                            <span><%= link.name %></span>
                        </a>
                    <% }); %>
                <% } else { %>
                    <p>Aucun portfolio externe ajouté.</p>
                <% } %>
            </div>
        </div>

        <div class="profile-main">
            <!-- Section des Projets -->
            <div class="section-header">
                <h2>Projets de <%= user.name %></h2>
                <% if (sessionUser && sessionUser.id === user.id) { %>
                    <a href="/projects/my-projects" class="btn">Gérer mes projets</a>
                <% } %>
            </div>
            <div class="projects-grid">
                <% if (projects && projects.length > 0) { %>
                    <% projects.forEach(project => { %>
                        <div class="project-card">
                            <a href="/projects/<%= project.id %>">
                                <img src="<%= project.main_image || '/images/default-project.png' %>" alt="Image de <%= project.title %>">
                                <h3><%= project.title %></h3>
                                <p><%= project.description.substring(0, 100) %>...</p>
                            </a>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p><%= user.name %> n'a pas encore publié de projet.</p>
                <% } %>
            </div>

            <!-- Section des Publications (Posts) -->
            <hr>
            <h2>Publications de <%= user.name %></h2>
            <div class="posts-feed">
                <% if (posts && posts.length > 0) { %>
                    <% posts.forEach(post => { %>
                    <div class="post-card">
                        <div class="post-author">
                            <img src="<%= post.authorAvatar || '/images/default-avatar.png' %>" alt="Avatar de <%= post.authorName %>">
                            <a href="/students/<%= post.author_id %>"><%= post.authorName %></a>
                        </div>
                        <div class="post-content">
                            <p><%= post.content %></p>
                            <% if (post.media_path) { %>
                                <% if (post.media_type.startsWith('image')) { %>
                                    <img src="<%= post.media_path %>" alt="Média de la publication">
                                <% } else if (post.media_type.startsWith('video')) { %>
                                    <video controls src="<%= post.media_path %>"></video>
                                <% } %>
                            <% } %>
                        </div>
                        <div class="post-footer">
                            <div class="post-actions">
                                <form action="/publications/<%= post.id %>/upvote" method="POST">
                                    <button type="submit" class="upvote-button">▲ <%= post.upvotes %></button>
                                </form>
                                <a href="/publications/<%= post.id %>" class="comment-button">💬</a>
                            </div>
                            <span class="post-date"><%= new Date(post.created_at).toLocaleDateString() %></span>
                        </div>
                    </div>
                    <% }); %>
                <% } else { %>
                    <p>Aucune publication pour le moment.</p>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
